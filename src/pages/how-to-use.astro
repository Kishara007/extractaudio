---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/en.json';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://videomp3.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'How to Use',
      item: 'https://videomp3.pages.dev/how-to-use',
    },
  ],
};
---

<BaseLayout
  title={en.seo.howToUse.title}
  description={en.seo.howToUse.description}
  canonicalPath="/how-to-use"
  pageId="howToUse"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 pt-8 sm:pt-12">
    <!-- Semantic Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm font-medium text-[#526D82] dark:text-[#9DB2BF]">
        <li>
          <a
            href="/"
            data-i18n="howToUse.breadcrumbHome"
            class="hover:text-[#27374D] dark:hover:text-[#DDE6ED] transition-colors"
          >
            {en.howToUse.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li
          aria-current="page"
          data-i18n="howToUse.breadcrumbCurrent"
          class="font-bold text-[#27374D] dark:text-[#DDE6ED]"
        >
          {en.howToUse.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1
        data-i18n="howToUse.title"
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#27374D] dark:text-[#DDE6ED]"
      >
        {en.howToUse.title}
      </h1>
      <p
        data-i18n="howToUse.subtitle"
        class="mt-3 text-base sm:text-lg text-[#526D82] dark:text-[#9DB2BF] leading-relaxed"
      >
        {en.howToUse.subtitle}
      </p>
    </header>

    <!-- Step-by-step Instructions -->
    <section aria-labelledby="guide-heading" class="mb-12">
      <h2
        id="guide-heading"
        data-i18n="howToUse.guideTitle"
        class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED] mb-5"
      >
        {en.howToUse.guideTitle}
      </h2>

      <div class="space-y-4">
        <article class="focal-card rounded-2xl p-6 flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#526D82] text-white dark:bg-[#9DB2BF] dark:text-[#16202E] font-bold">
            1
          </span>
          <div>
            <h3 data-i18n="howToUse.step1Title" class="text-lg font-bold text-[#27374D] dark:text-[#DDE6ED]">
              {en.howToUse.step1Title}
            </h3>
            <p data-i18n="howToUse.step1Body" class="mt-2 text-sm sm:text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
              {en.howToUse.step1Body}
            </p>
          </div>
        </article>

        <article class="focal-card rounded-2xl p-6 flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#526D82] text-white dark:bg-[#9DB2BF] dark:text-[#16202E] font-bold">
            2
          </span>
          <div>
            <h3 data-i18n="howToUse.step2Title" class="text-lg font-bold text-[#27374D] dark:text-[#DDE6ED]">
              {en.howToUse.step2Title}
            </h3>
            <p data-i18n="howToUse.step2Body" class="mt-2 text-sm sm:text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
              {en.howToUse.step2Body}
            </p>
          </div>
        </article>

        <article class="focal-card rounded-2xl p-6 flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#526D82] text-white dark:bg-[#9DB2BF] dark:text-[#16202E] font-bold">
            3
          </span>
          <div>
            <h3 data-i18n="howToUse.step3Title" class="text-lg font-bold text-[#27374D] dark:text-[#DDE6ED]">
              {en.howToUse.step3Title}
            </h3>
            <p data-i18n="howToUse.step3Body" class="mt-2 text-sm sm:text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
              {en.howToUse.step3Body}
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- Popular Use Cases -->
    <section aria-labelledby="usecases-heading" class="mb-10">
      <h2
        id="usecases-heading"
        data-i18n="howToUse.useCasesTitle"
        class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED] mb-5"
      >
        {en.howToUse.useCasesTitle}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <article class="focal-card rounded-2xl p-5">
          <h3 data-i18n="howToUse.useCase1Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.howToUse.useCase1Title}
          </h3>
          <p data-i18n="howToUse.useCase1Body" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.howToUse.useCase1Body}
          </p>
        </article>

        <article class="focal-card rounded-2xl p-5">
          <h3 data-i18n="howToUse.useCase2Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.howToUse.useCase2Title}
          </h3>
          <p data-i18n="howToUse.useCase2Body" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.howToUse.useCase2Body}
          </p>
        </article>

        <article class="focal-card rounded-2xl p-5">
          <h3 data-i18n="howToUse.useCase3Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.howToUse.useCase3Title}
          </h3>
          <p data-i18n="howToUse.useCase3Body" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.howToUse.useCase3Body}
          </p>
        </article>

        <article class="focal-card rounded-2xl p-5">
          <h3 data-i18n="howToUse.useCase4Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.howToUse.useCase4Title}
          </h3>
          <p data-i18n="howToUse.useCase4Body" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.howToUse.useCase4Body}
          </p>
        </article>
      </div>
    </section>

    <div class="text-center">
      <a
        href="/"
        data-i18n="howToUse.ctaButton"
        class="inline-flex items-center justify-center min-h-[48px] px-7 py-3 rounded-2xl bg-[#526D82] hover:bg-[#27374D] text-white dark:bg-[#9DB2BF] dark:text-[#16202E] dark:hover:bg-[#DDE6ED] font-bold text-base shadow-md transition-colors"
      >
        {en.howToUse.ctaButton}
      </a>
    </div>
  </div>
</BaseLayout>
