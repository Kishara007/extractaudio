---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmailButton from '../components/CopyEmailButton';
import en from '../i18n/en.json';

const DEVELOPER_EMAIL = 'kisharadilshan007@gmail.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://videomp3.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Hire Me',
      item: 'https://videomp3.pages.dev/hire-me',
    },
  ],
};
---

<BaseLayout
  title={en.seo.hireMe.title}
  description={en.seo.hireMe.description}
  canonicalPath="/hire-me"
  pageId="hireMe"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 pt-8 sm:pt-12">
    <!-- Semantic Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm font-medium text-[#526D82] dark:text-[#9DB2BF]">
        <li>
          <a
            href="/"
            data-i18n="hireMe.breadcrumbHome"
            class="hover:text-[#27374D] dark:hover:text-[#DDE6ED] transition-colors"
          >
            {en.hireMe.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li
          aria-current="page"
          data-i18n="hireMe.breadcrumbCurrent"
          class="font-bold text-[#27374D] dark:text-[#DDE6ED]"
        >
          {en.hireMe.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <section class="focal-card rounded-3xl p-6 sm:p-10">
      <div class="inline-flex items-center gap-2 rounded-full bg-[#DDE6ED] dark:bg-[#16202E] border border-[#9DB2BF]/45 dark:border-[#526D82]/50 px-3.5 py-1.5 text-xs sm:text-sm font-bold text-[#27374D] dark:text-[#9DB2BF]">
        <span class="h-2 w-2 rounded-full bg-[#526D82] dark:bg-[#9DB2BF]" aria-hidden="true" />
        <span data-i18n="hireMe.badge">{en.hireMe.badge}</span>
      </div>

      <h1
        data-i18n="hireMe.title"
        class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-[#27374D] dark:text-[#DDE6ED]"
      >
        {en.hireMe.title}
      </h1>

      <p
        data-i18n="hireMe.intro"
        class="mt-4 text-lg font-semibold text-[#27374D] dark:text-[#DDE6ED]"
      >
        {en.hireMe.intro}
      </p>

      <p
        data-i18n="hireMe.body"
        class="mt-2.5 text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]"
      >
        {en.hireMe.body}
      </p>

      <h2
        data-i18n="hireMe.servicesTitle"
        class="mt-8 mb-4 text-xl font-bold text-[#27374D] dark:text-[#DDE6ED]"
      >
        {en.hireMe.servicesTitle}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="rounded-2xl bg-[#DDE6ED]/50 dark:bg-[#16202E] border border-[#9DB2BF]/40 dark:border-[#526D82]/45 p-5">
          <h3 data-i18n="hireMe.card1Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.hireMe.card1Title}
          </h3>
          <p data-i18n="hireMe.card1Desc" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.hireMe.card1Desc}
          </p>
        </article>

        <article class="rounded-2xl bg-[#DDE6ED]/50 dark:bg-[#16202E] border border-[#9DB2BF]/40 dark:border-[#526D82]/45 p-5">
          <h3 data-i18n="hireMe.card2Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.hireMe.card2Title}
          </h3>
          <p data-i18n="hireMe.card2Desc" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.hireMe.card2Desc}
          </p>
        </article>

        <article class="rounded-2xl bg-[#DDE6ED]/50 dark:bg-[#16202E] border border-[#9DB2BF]/40 dark:border-[#526D82]/45 p-5">
          <h3 data-i18n="hireMe.card3Title" class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.hireMe.card3Title}
          </h3>
          <p data-i18n="hireMe.card3Desc" class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {en.hireMe.card3Desc}
          </p>
        </article>
      </div>

      <div class="mt-8 pt-6 border-t border-[#9DB2BF]/30 dark:border-[#526D82]/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <p data-i18n="hireMe.closing" class="text-lg font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {en.hireMe.closing}
          </p>
          <p class="mt-1 text-sm text-[#526D82] dark:text-[#9DB2BF]">
            <span data-i18n="hireMe.emailLabel">{en.hireMe.emailLabel}</span>:{' '}
            <a
              href={`mailto:${DEVELOPER_EMAIL}`}
              class="font-semibold text-[#27374D] dark:text-[#DDE6ED] underline decoration-[#9DB2BF] underline-offset-4"
            >
              {DEVELOPER_EMAIL}
            </a>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${DEVELOPER_EMAIL}`}
            data-i18n="hireMe.sendEmail"
            class="inline-flex items-center justify-center min-h-[44px] px-5 py-3 rounded-xl bg-[#526D82] hover:bg-[#27374D] text-white dark:bg-[#9DB2BF] dark:text-[#16202E] dark:hover:bg-[#DDE6ED] text-sm font-bold shadow-sm transition-colors"
          >
            {en.hireMe.sendEmail}
          </a>
          <CopyEmailButton email={DEVELOPER_EMAIL} client:load />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
